# =============================================================================
# Og Stays - Room 1451 - Environment Variables (production template)
# Set these in Vercel → Project → Settings → Environment Variables (Production)
# Never commit real secrets.
# Domain: https://1451.edugeniushub.com
# =============================================================================

# REQUIRED — Auth.js returns 500 on /api/auth/* without this
# Generate: openssl rand -base64 32
AUTH_SECRET=

# REQUIRED — production URL (no trailing slash)
AUTH_URL=https://1451.edugeniushub.com
NEXTAUTH_URL=https://1451.edugeniushub.com

# REQUIRED on Vercel / custom domain
AUTH_TRUST_HOST=true

# REQUIRED — MongoDB Atlas URI
MONGODB_URI=

# Optional seed admin (only if users collection is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=