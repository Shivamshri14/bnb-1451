# =============================================================================
# Og Stays - Room 1451 - Environment Variables (production template)
# Copy to .env.local (local) or set in Hostinger Node.js Environment Variables
# Never commit real secrets.
# Domain: https://1451.edugeniushub.com
# =============================================================================

# --- NextAuth / Auth.js v5 (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Production app URL (no trailing slash)
NEXTAUTH_URL=https://1451.edugeniushub.com
# Auth.js: trust host header behind Hostinger proxy / custom domain
AUTH_TRUST_HOST=true

# Alias used by some Auth.js docs (optional - AUTH_SECRET is enough for v5)
# NEXTAUTH_SECRET=

# --- MongoDB Atlas (required in production) ---
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bnb?retryWrites=true&w=majority
MONGODB_URI=

# --- Optional seed admin (created only when the users collection is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Not used by this app (NextAuth JWT uses AUTH_SECRET) ---
# JWT_SECRET=